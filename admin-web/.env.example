# Marketplace Web API URL
VITE_API_URL=http://localhost:5209/api

# Google Maps Client-Side API Key (Browser Key - WEB-011 / Phase 5)
# In Google Cloud Console, this key MUST be restricted:
# 1. Application restriction: HTTP referrers (e.g. http://localhost:*/* for dev, https://*.egyptshop.eg/* for prod)
# 2. API restrictions: Maps JavaScript API, Places API, Geocoding API
# CRITICAL: Never put private server-side keys here (VITE variables are exposed in client bundles).
VITE_GOOGLE_MAPS_API_KEY=
