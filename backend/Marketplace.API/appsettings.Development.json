{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Admin": {
    "WebEnabled": true
  },
  "Carrier": {
    "DevSecret": "dev-carrier-secret"
  },
  "SecurityHeaders": {
    "EnableCsp": true,
    "CspReportOnly": false,
    "ReportUri": "/api/security/csp-reports",
    "EnableHsts": true,
    "HstsMaxAgeSeconds": 31536000,
    "HstsIncludeSubDomains": true,
    "HstsPreload": false
  }
}